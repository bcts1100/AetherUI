[AetherPlugin]
version=1
[plugin]
id=aether-sleek-graphite
name=Graphite%20Desk
description=Quiet charcoal surfaces with a cool blue accent.%20Native%20clock,%20focused%20app%20and%20desktop%20shortcuts.
[widget:clock]
type=clock
label=Today
style=theme
color=83B7FF
width=320
height=104
monitor=
x=24
y=24

[widget:focus]
type=focused-app
label=In%20focus
style=theme
color=83B7FF
width=320
height=88
monitor=
x=24
y=144

[widget:activities]
type=quick-action
label=Apps
action=activities
style=accent
color=83B7FF
width=152
height=88
monitor=
x=24
y=248

[widget:quick-settings]
type=quick-action
label=Controls
action=quick-settings
style=accent
color=83B7FF
width=152
height=88
monitor=
x=192
y=248

[widget:studio]
type=quick-action
label=Customize
action=studio
style=theme
color=83B7FF
width=320
height=88
monitor=
x=24
y=352
